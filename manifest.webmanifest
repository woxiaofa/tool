{
  "name": "文本格式化工具箱",
  "short_name": "文本格式化",
  "description": "免费开源的纯前端在线文本格式化工具：CSS/HTML 压缩美化、Markdown 与 HTML 互转、段落整理、中英排版、JSON/URL/Base64 编解码。本地运行，内容不上传。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "id": "text-formatter-toolbox",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#f4f6fa",
  "theme_color": "#4f46e5",
  "categories": ["utilities", "developer", "productivity"],
  "icons": [
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "CSS 压缩 / 美化", "short_name": "CSS", "url": "./index.html#css", "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Markdown 互转", "short_name": "Markdown", "url": "./index.html#htmlmd", "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "段落整理", "short_name": "段落", "url": "./index.html#para", "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "中英排版", "short_name": "排版", "url": "./index.html#typo", "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "通用转换", "short_name": "转换", "url": "./index.html#common", "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }] }
  ]
}
